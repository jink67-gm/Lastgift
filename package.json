{
  "name": "lastgift",
  "version": "0.1.0",
  "private": true,
  "description": "자정의 마지막 선물 · 꼬마 요정의 첫 배달 (2~4인 협동 브라우저 게임)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
